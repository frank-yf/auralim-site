---
interface Props { name: 'sunrise.fill' | 'sunset.fill' | 'sun.max.fill' | 'moon.fill'; size?: number; }
const { name, size = 16 } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const source = `${base}/images/symbols/${name}.png`;
---
<span class="native-symbol" data-symbol={name} aria-hidden="true" style={`width:${size}px;height:${size}px;--symbol-mask:url('${source}')`}></span>
